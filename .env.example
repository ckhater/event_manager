# Database (Neon in production — https://neon.tech)
# Paste the pooled URL (with the -pooler suffix) and the direct URL here.
# `pgbouncer=true` tells Prisma that connection pooling is handled externally
# (recommended with Neon).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/eventdb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/eventdb?sslmode=require"

# JWT HS256 secret for session cookies (32+ random characters).
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-random-secret-of-at-least-32-characters"

# Admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="AdminPassword"

# Image uploads (Vercel Blob, free tier).
# Vercel Dashboard → your project → Storage → Create → Blob → copy the token.
# Without it, the app works but cover-image uploads return a clear 500 error.
BLOB_READ_WRITE_TOKEN=""
